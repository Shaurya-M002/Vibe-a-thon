# Copy to .env. The CLI will load it without overriding your shell environment.
GEMINI_BACKEND=developer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# For Google Cloud authentication, use GEMINI_BACKEND=vertex and ADC:
# gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Decimal strings in atomic USDC units: 1 USDC = 1000000 units.
GOVERNOR_SESSION_CAP=10000
GOVERNOR_PER_CALL_CAP=3000
GOVERNOR_DATA_DIR=.governor
GOVERNOR_MAX_TURNS=8
GOVERNOR_MAX_TOOL_CALLS=16
GOVERNOR_RUN_TIMEOUT_SECONDS=120
GOVERNOR_MODEL_TIMEOUT_SECONDS=30

# mock by default; solana-devnet enables the allowlisted local vendor in CLI runs.
# Start governor-vendor and fund both USDC accounts before using real payments.
GOVERNOR_PAYMENT_MODE=mock

# Wallet CLI settings. Live payments use the fixed Devnet RPC and data-dir wallet.
SOLANA_WALLET_PATH=.governor/wallets/solana-devnet.json
SOLANA_RPC_URL=https://api.devnet.solana.com
